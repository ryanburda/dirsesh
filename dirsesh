#!/bin/bash

usage() {
  cat <<'EOF'
dirsesh - One configurable tmux session per directory

Usage:
  dirsesh                                        # Show help message
  dirsesh <command> -help                        # Show what one command does, in detail

  dirsesh at <path> [-noconfig] [-name[=NAME]]   # Start or switch to session at a directory
    path                                         # The directory to start the session at
    -noconfig                                    # Ignore any configuration claiming that path
    -name[=NAME]                                 # Name the session; prompts for one if NAME is not given

  dirsesh config-match [path]                    # Configurations claiming a path (defaults to the current directory)

  dirsesh init                                   # Install dirsesh's tmux hooks (put this in tmux.conf)

  dirsesh ls                                     # Choose a directory under $HOME, and open a session there
    $DIRSESH_LS_ROOT                             # Where to search, instead of $HOME
    $DIRSESH_LS_MAX_DEPTH                        # How deep to search, instead of no limit
  dirsesh git [-brief] [-filter] [-fetch]        # Choose a git repository under $HOME, and open a session there
    -brief                                       # Show what each repository has waiting, beside its path
    -filter                                      # List only the repositories that have something waiting
    -fetch                                       # Fetch first, so the ahead/behind counts are current
    $DIRSESH_GIT_ROOT                            # Where to search, instead of $HOME
    $DIRSESH_GIT_MAX_DEPTH                       # How deep to search, instead of 5 levels (0 for no limit)
  dirsesh git-wt                                 # Choose a worktree of the current repository, and open a session there
  dirsesh z <query>...                           # Open a session at a directory zoxide knows, named by keywords
    query                                        # Keywords to match, or a directory to use as written
  dirsesh zi [query]...                          # Choose a directory zoxide knows with fzf, and open a session there
    query                                        # Keywords to narrow the list with before it opens

  dirsesh bm [char] [-p]                         # Open a session at a bookmark; chooses one with fzf when char is left off
    char                                         # The character the bookmark is keyed by
    -p                                           # Print every bookmark as "char<TAB>directory" instead
  dirsesh bm-set <char> [path]                   # Bookmark a directory, one printable character each
    char                                         # The character to bookmark at
    path                                         # The directory to bookmark (defaults to the current directory)
  dirsesh bm-rm <char>                           # Remove a bookmark
  dirsesh bm-status [path]                       # Bookmarks with a tmux session open at them, for a status line
  dirsesh bm-status-init                         # Install the tmux hooks `bm-status` needs (`dirsesh init` too)

  dirsesh switch [session]                       # Switch to another running session
    session                                      # Switch straight to this one instead of picking
  dirsesh last                                   # Switch back to the session you came from
  dirsesh kill [session]                         # Kill a running session
    session                                      # Kill this one instead of picking
  dirsesh logs [session]                         # Browse the logs a dirsesh configuration wrote
    session                                      # Browse only this session's logs

See https://github.com/ryanburda/dirsesh for more documentation
EOF
}

init_help() {
  # `dirsesh init` is the top level's own verb rather than a script under src/,
  # so `-help` cannot read its detail out of a header comment the way it does
  # for the others. It is written here instead.
  cat <<'EOF'
init: install the tmux hooks dirsesh works through.

Usage: dirsesh init

Meant for tmux.conf, where it runs once per server:

  run-shell "dirsesh init"

It installs both halves:

  session-closed                   runs a configuration's `kill` when a session
                                   it built closes, however it closes
  session-created, session-closed  redraw the `bm-status` line as soon as a
                                   session opens or closes

Both are appended, so anything else already on those hooks survives, and both
drop the hooks a previous run left behind, so re-sourcing tmux.conf does not
stack duplicates.

`dirsesh bm-status-init` installs the second half on its own, for a tmux.conf
that wants the status line hooks without the cleanup hook.
EOF
}

####################
# helper functions #
####################
notify() {
  # Show a message: tmux display-message inside tmux, stderr otherwise.
  # stderr because several commands are run inside a command substitution whose
  # stdout is their return value -- and a program run from a tmux popup loses
  # its stderr when the popup closes.
  local msg="$1"
  if [ -n "$TMUX" ]; then
    tmux display-message "$msg"
  else
    echo "$msg" >&2
  fi
}

self_dir() {
  # Directory holding this program, with symlinks resolved. The scripts live
  # under src/ beside it in the checkout, and install.sh links this program
  # onto PATH, so the link has to be followed to find them.
  local self="$0"
  case "$self" in
    */*) ;;
    *) self=$(command -v -- "$self") || return 1 ;;
  esac

  # Hop link by link rather than trusting `readlink -f`, which BSD readlink
  # (macOS) does not have.
  while [ -L "$self" ]; do
    local target=$(readlink "$self")
    case "$target" in
      /*) self="$target" ;;
      *) self="$(dirname "$self")/$target" ;;
    esac
  done

  (cd "$(dirname "$self")" && pwd -P)
}

src_help() {
  # Print a script's header comment: the run of #-lines under its shebang,
  # with the leading `# ` taken off. That header is the only place a
  # subcommand's usage is written down in full, so `-help` cannot drift from
  # it.
  #
  # Args:
  #   $1: script: path to the script under src/
  #
  # The second sed drops the blank line the header's opening `#` leaves behind.
  sed -n '2,${
    /^#/!q
    s/^#[[:space:]]\{0,1\}//
    p
  }' "$1" | sed '/./,$!d'
}

run_src() {
  # Run a script under src/, passing on any remaining arguments. A subcommand
  # backed by a script in a group directory names it as <group>/<name>;
  # anything else sits directly under src/ under its own name.
  #
  # Args:
  #   $1: name: the script's path relative to src/
  local name="$1"
  shift

  local dir
  if ! dir=$(self_dir); then
    notify "Error: could not locate the dirsesh scripts"
    exit 1
  fi

  local script="$dir/src/$name"
  if [ ! -f "$script" ]; then
    notify "Error: missing script '$script'"
    exit 1
  fi

  # -help rather than -h: subcommands have flags of their own, and a flag that
  # means two things on one subcommand means two things everywhere.
  if [ "$1" = "-help" ]; then
    src_help "$script"
    return 0
  fi

  # `bash` rather than executing it directly, so a checkout whose files lost
  # their execute bit still works.
  bash "$script" "$@"
}

run_src_at() {
  # Run a chooser under src/ and open a session at the directory it printed.
  # This is the whole of what makes `dirsesh git` a command rather than
  # something you substitute into `dirsesh at` yourself.
  #
  # Args:
  #   $1: name: the script's path relative to src/
  #   $@: the arguments to pass it
  #
  # The scripts under src/ still do one thing each: they choose a directory
  # and print it. Joining that answer to `at` is done here, once, rather than
  # in every one of them -- none of them has to find its way back to this
  # program, and a chooser stays testable by running it and reading what it
  # printed.
  local name="$1"
  shift

  # run_src answers -help itself, but only when the flag is in the position it
  # looks at; passing it on rather than reading it here keeps that one rule.
  if [ "$1" = "-help" ]; then
    run_src "$name" -help
    return 0
  fi

  # Status and answer are both wanted, so they are taken in two steps: an
  # assignment's status is the substitution's, but only when nothing else is
  # declared on the same line.
  local answer status
  answer=$(run_src "$name" "$@")
  status=$?

  # The chooser has already said what went wrong -- on stderr, or through
  # tmux -- so this passes its status on without a message of its own.
  [ "$status" -eq 0 ] || exit "$status"

  # Backing out of a chooser prints nothing and succeeds. Nothing was chosen,
  # so nothing is opened, and that is not a failure either.
  [ -n "$answer" ] || exit 0

  run_src at at "$answer"
}

# Parse arguments
if [ $# -eq 0 ]; then
  usage
  exit 0
fi

command="$1"
shift

case "$command" in
  # at and config-match are two verbs of one program: they share the
  # configuration lookup and the session bookkeeping, so they share a file,
  # and the verb is passed on rather than swallowed here.
  at | config-match)
    # Passing the verb on puts -help in second position, which is not where
    # run_src looks for it, so it is answered here instead.
    if [ "$1" = "-help" ]; then
      run_src at -help
    else
      run_src at "$command" "$@"
    fi
    ;;
  init)
    # The one verb that spans two scripts: `at`'s session-closed hook, which
    # runs a configuration's `kill`, and `bookmark`'s status line hooks. One
    # `run-shell "dirsesh init"` in tmux.conf is meant to be the whole of
    # dirsesh's setup, so this installs everything that hangs off a hook.
    #
    # Sequenced rather than run independently: both resolve the same path to
    # this program and install hooks the same way, so a failure in the first
    # is a failure the second would only repeat.
    if [ "$1" = "-help" ]; then
      init_help
    elif [ $# -gt 0 ]; then
      notify "Error: 'dirsesh init' takes no arguments"
      exit 1
    else
      run_src at init && run_src bookmark status-init
    fi
    ;;
  _session_closed)
    # Internal: the session-closed hook `dirsesh init` installs calls back on
    # this. Spelled out here and as HOOK_CLOSED in src/at, which is what
    # bakes it into the hook.
    run_src at "$command" "$@"
    ;;
  ls)
    run_src_at pick/ls "$@"
    ;;
  git)
    run_src_at pick/git "$@"
    ;;
  git-wt)
    run_src_at pick/git-wt "$@"
    ;;
  z)
    run_src_at pick/z "$@"
    ;;
  zi)
    run_src_at pick/zi "$@"
    ;;
  bm | bm-set | bm-rm | bm-status | bm-status-init)
    # The bookmark verbs are one program the way at and config-match are:
    # they share the bookmark store, the character a bookmark is keyed by and
    # the status line refresh, so they share a file, and the verb is passed on
    # rather than swallowed here.
    #
    # Passing the verb on puts -help in second position, which is not where
    # run_src looks for it, so it is answered here instead.
    if [ "$1" = "-help" ]; then
      run_src bookmark -help
    elif [ "$command" != "bm" ]; then
      run_src bookmark "${command#bm-}" "$@"
    elif [ "$1" = "-p" ]; then
      # -p prints the bookmarks rather than opening one, so it is the one
      # bookmark answer that does not go to `at`. Which of the two it is has
      # to be known before the script runs, so the flag is read here; the
      # script still checks what follows it.
      run_src bookmark list "${@:2}"
    else
      # The only bookmark verb whose answer is a directory: `bm m` opens a
      # session at what m bookmarks, `bm` chooses which one first.
      run_src_at bookmark go "$@"
    fi
    ;;
  _bookmark-entries | _bookmark-refresh-status)
    # Internal: the first rebuilds the `bm` list's rows for its reload
    # binding, the second is what the hooks `bm-status-init` installs call
    # back on. Both
    # are spelled out again in src/bookmark, which is what bakes them into the
    # binding and the hook.
    run_src bookmark "$command" "$@"
    ;;
  kill)
    run_src session/kill "$@"
    ;;
  last)
    run_src session/last "$@"
    ;;
  logs)
    run_src session/logs "$@"
    ;;
  switch)
    run_src session/switch "$@"
    ;;
  help | -help)
    usage
    ;;
  *)
    notify "Error: Unknown command '$command'"
    usage
    exit 1
    ;;
esac
