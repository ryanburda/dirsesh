#!/bin/bash

usage() {
  cat <<'EOF'
dirsesh - One configurable tmux session per directory

Usage:
  dirsesh                                        # Show help message
  dirsesh <command> -help                        # Show what one command does, in detail

  dirsesh at <path> [-noconfig] [-name[=NAME]]   # Start or switch to session at a directory
    path                                         # The directory to start the session at
    -noconfig                                    # Ignore any configuration claiming that path
    -name[=NAME]                                 # Name the session; prompts for one if NAME is not given

  dirsesh match [path]                           # Configurations claiming a path (defaults to the current directory)

  dirsesh init                                   # Install dirsesh's tmux hooks (put this in tmux.conf)

  dirsesh session-switch [session]               # Switch to another running session
    session                                      # Switch straight to this one instead of picking
  dirsesh session-last                           # Switch back to the session you came from
  dirsesh session-kill [session]                 # Kill a running session
    session                                      # Kill this one instead of picking
  dirsesh session-logs [session]                 # Browse the logs a dirsesh configuration wrote
    session                                      # Browse only this session's logs

  dirsesh bookmark-set <char> [path]             # Bookmark a directory, one printable character each
    char                                         # The character to bookmark at
    path                                         # The directory to bookmark (defaults to the current directory)
  dirsesh bookmark-remove <char>                 # Remove a bookmark
  dirsesh bookmark-get <char>                    # Print the directory a bookmark points at
  dirsesh bookmark-pick                          # Choose a bookmark with fzf and print its directory
  dirsesh bookmark-list                          # Every bookmark as "char<TAB>directory"
  dirsesh bookmark-status [path]                 # Bookmarks with a tmux session open at them, for a status line
  dirsesh bookmark-status-init                   # Install the tmux hooks `bookmark-status` needs (`dirsesh init` too)

  dirsesh pick-dir                               # Print a directory under $HOME
  dirsesh pick-repo [-brief] [-filter] [-fetch]  # Print a git repository under $HOME
    -brief                                       # Show what each repository has waiting, beside its path
    -filter                                      # List only the repositories that have something waiting
    -fetch                                       # Fetch first, so the ahead/behind counts are current
  dirsesh pick-worktree                          # Print a worktree of the current repository

The pickers print a path on stdout, so they compose with `dirsesh at`:

  dirsesh at "$(dirsesh pick-repo)"
  dirsesh at "$(dirsesh bookmark-get m)"

See https://github.com/ryanburda/tmux-dirsesh for more documentation
EOF
}

init_help() {
  # `dirsesh init` is the top level's own verb rather than a script under src/,
  # so `-help` cannot read its detail out of a header comment the way it does
  # for the others. It is written here instead.
  cat <<'EOF'
init: install the tmux hooks dirsesh works through.

Usage: dirsesh init

Meant for tmux.conf, where it runs once per server:

  run-shell "dirsesh init"

It installs both halves:

  session-closed                   runs a configuration's `kill` when a session
                                   it built closes, however it closes
  session-created, session-closed  redraw the `bookmark-status` line as soon as
                                   a session opens or closes

Both are appended, so anything else already on those hooks survives, and both
drop the hooks a previous run left behind, so re-sourcing tmux.conf does not
stack duplicates.

`dirsesh bookmark-status-init` installs the second half on its own, for a
tmux.conf that wants the status line hooks without the cleanup hook.
EOF
}

####################
# helper functions #
####################
notify() {
  # Show a message: tmux display-message inside tmux, stderr otherwise.
  # stderr because several commands are run inside a command substitution whose
  # stdout is their return value -- and a program run from a tmux popup loses
  # its stderr when the popup closes.
  local msg="$1"
  if [ -n "$TMUX" ]; then
    tmux display-message "$msg"
  else
    echo "$msg" >&2
  fi
}

self_dir() {
  # Directory holding this program, with symlinks resolved. The scripts live
  # under src/ beside it in the checkout, and install.sh links this program
  # onto PATH, so the link has to be followed to find them.
  local self="$0"
  case "$self" in
    */*) ;;
    *) self=$(command -v -- "$self") || return 1 ;;
  esac

  # Hop link by link rather than trusting `readlink -f`, which BSD readlink
  # (macOS) does not have.
  while [ -L "$self" ]; do
    local target=$(readlink "$self")
    case "$target" in
      /*) self="$target" ;;
      *) self="$(dirname "$self")/$target" ;;
    esac
  done

  (cd "$(dirname "$self")" && pwd -P)
}

src_help() {
  # Print a script's header comment: the run of #-lines under its shebang,
  # with the leading `# ` taken off. That header is the only place a
  # subcommand's usage is written down in full, so `-help` cannot drift from
  # it.
  #
  # Args:
  #   $1: script: path to the script under src/
  #
  # The second sed drops the blank line the header's opening `#` leaves behind.
  sed -n '2,${
    /^#/!q
    s/^#[[:space:]]\{0,1\}//
    p
  }' "$1" | sed '/./,$!d'
}

run_src() {
  # Run a script under src/, passing on any remaining arguments. A subcommand
  # named <group>-<name> lives a directory down as src/<group>/<name>;
  # anything else sits directly under src/ under the subcommand's own name.
  #
  # Args:
  #   $1: name: the script's path relative to src/
  local name="$1"
  shift

  local dir
  if ! dir=$(self_dir); then
    notify "Error: could not locate the dirsesh scripts"
    exit 1
  fi

  local script="$dir/src/$name"
  if [ ! -f "$script" ]; then
    notify "Error: missing script '$script'"
    exit 1
  fi

  # -help rather than -h: subcommands have flags of their own, and a flag that
  # means two things on one subcommand means two things everywhere.
  if [ "$1" = "-help" ]; then
    src_help "$script"
    return 0
  fi

  # `bash` rather than executing it directly, so a checkout whose files lost
  # their execute bit still works.
  bash "$script" "$@"
}

# Parse arguments
if [ $# -eq 0 ]; then
  usage
  exit 0
fi

command="$1"
shift

case "$command" in
  # at and match are two verbs of one program: they share the configuration
  # lookup and the session bookkeeping, so they share a file, and the verb is
  # passed on rather than swallowed here.
  at | match)
    # Passing the verb on puts -help in second position, which is not where
    # run_src looks for it, so it is answered here instead.
    if [ "$1" = "-help" ]; then
      run_src at -help
    else
      run_src at "$command" "$@"
    fi
    ;;
  init)
    # The one verb that spans two scripts: `at`'s session-closed hook, which
    # runs a configuration's `kill`, and `bookmark`'s status line hooks. One
    # `run-shell "dirsesh init"` in tmux.conf is meant to be the whole of
    # dirsesh's setup, so this installs everything that hangs off a hook.
    #
    # Sequenced rather than run independently: both resolve the same path to
    # this program and install hooks the same way, so a failure in the first
    # is a failure the second would only repeat.
    if [ "$1" = "-help" ]; then
      init_help
    elif [ $# -gt 0 ]; then
      notify "Error: 'dirsesh init' takes no arguments"
      exit 1
    else
      run_src at init && run_src bookmark status-init
    fi
    ;;
  _session_closed)
    # Internal: the session-closed hook `dirsesh init` installs calls back on
    # this. Spelled out here and as HOOK_CLOSED in src/at, which is what
    # bakes it into the hook.
    run_src at "$command" "$@"
    ;;
  bookmark-set | bookmark-remove | bookmark-get | bookmark-pick \
    | bookmark-list | bookmark-status | bookmark-status-init)
    # The bookmark verbs are one program the way at and match are: they share
    # the bookmark store, the character a bookmark is keyed by and the status
    # line refresh, so they share a file, and the verb is passed on rather
    # than swallowed here.
    #
    # Passing the verb on puts -help in second position, which is not where
    # run_src looks for it, so it is answered here instead.
    if [ "$1" = "-help" ]; then
      run_src bookmark -help
    else
      run_src bookmark "${command#bookmark-}" "$@"
    fi
    ;;
  _bookmark-entries | _bookmark-refresh-status)
    # Internal: the first rebuilds `bookmark-pick`'s rows for its reload
    # binding, the second is what the hooks `bookmark-status-init` installs
    # call back on. Both are spelled out again in src/bookmark, which is what
    # bakes them into the binding and the hook.
    run_src bookmark "$command" "$@"
    ;;
  pick-dir)
    run_src pick/dir "$@"
    ;;
  pick-repo)
    run_src pick/repo "$@"
    ;;
  pick-worktree)
    run_src pick/worktree "$@"
    ;;
  session-kill)
    run_src session/kill "$@"
    ;;
  session-last)
    run_src session/last "$@"
    ;;
  session-logs)
    run_src session/logs "$@"
    ;;
  session-switch)
    run_src session/switch "$@"
    ;;
  help | -help)
    usage
    ;;
  *)
    notify "Error: Unknown command '$command'"
    usage
    exit 1
    ;;
esac
