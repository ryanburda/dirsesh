#!/usr/bin/env bash
#
# git: choose a git repository under $HOME -- or under $DIRSESH_GIT_ROOT, if
# that is set -- with fzf, and open a tmux session there.
#
# Usage: dirsesh git [-brief] [-filter] [-fetch]
#   -brief     Show what each repository has waiting, beside its path
#   -filter    List only the repositories that have something waiting
#   -fetch     Fetch every repository first, so the ahead/behind counts are
#              current. Only means something with -brief or -filter, and is
#              what makes either slow.
#
# The three are independent: -brief says what to show, -filter says what to
# leave out, and -fetch says how current the remote half of both is.
#
#   dirsesh git                          every repository, path only
#   dirsesh git -brief                   every repository, and what it has waiting
#   dirsesh git -filter                  only the ones with something waiting
#   dirsesh git -brief -filter -fetch    both, against fetched remotes
#
# Backing out opens nothing and exits 0.
#
# The walk starts at $HOME, or at $DIRSESH_GIT_ROOT when that is set, and goes
# 5 levels down from there unless $DIRSESH_GIT_MAX_DEPTH says otherwise. It
# prunes .git, node_modules and every hidden directory, so it stays fast and
# does not descend into a dependency that vendored its own repository.
# Repositories are found by their .git rather than by asking each directory
# whether it is one, which is what makes linked worktrees show up alongside
# ordinary clones: a worktree carries a .git *file* rather than a directory.
#
# Only directories with a working tree are listed. A bare repository has none,
# so `git clone --bare repo.git` never appears, and neither does the container
# of a bare checkout -- the ~/code/project holding .bare and its worktrees. The
# worktrees themselves are listed, and are what you want a session at.
#
# -brief
#
#   /home/you/code/api        main ↑2 +41 -7
#   /home/you/code/dotfiles   main ↓1
#   /home/you/code/site       draft ↑1 ?3
#   /home/you/code/tools      main
#
#   ↑n     commits ahead of upstream
#   ↓n     commits behind upstream
#   +n -n  lines added and removed against HEAD, staged work included
#   ?n     untracked files, counting a new directory once
#
# A repository with none of them shows its branch alone, which is the whole
# point of -brief without -filter: the quiet ones stay on the list.
#
# -filter
#
# Keeps only the repositories with something waiting -- any of the counts above
# above zero -- and heads the list with how many that was out of how many were
# checked, so a short list is distinguishable from a broken one:
#
#   :: 3 of 27 repositories have changes
#
# -fetch
#
# Everything but ↑ and ↓ is read from the working tree, and is current whether
# or not you fetch. ↑ and ↓ are counted against the upstream ref as it stands
# on disk, which is where the last fetch left it -- the same counts `git status`
# reports, and stale in the same way. -fetch refreshes every repository first so
# they are not, at the cost of a network round trip per repository, which is the
# whole of the wait.
#
# DIRSESH_GIT_ROOT
#
# Where the walk starts. $HOME unless this names somewhere else -- ~/code, a
# work checkout, anywhere with more than one repository under it:
#
#   DIRSESH_GIT_ROOT="$HOME/code" dirsesh git
#
# The depth bound is counted from there, so a narrower root also reaches
# deeper. Export it from the file your shell reads for *every* shell rather
# than only interactive ones -- ~/.zshenv for zsh, ~/.bash_profile or
# ~/.profile for bash -- because a tmux popup runs `$SHELL -c`, which reads
# neither ~/.zshrc nor ~/.bashrc. The same goes for the one below.
#
# DIRSESH_GIT_MAX_DEPTH
#
# How far down from the root to walk. 5 unless this says otherwise:
#
#   DIRSESH_GIT_MAX_DEPTH=3 dirsesh git
#
# A repository is found by its .git, which sits one level below the repository
# itself, so 5 reaches a repository four directories down -- $root/a/b/c/repo
# -- and 1 finds only a repository at the root. Raise it for repositories kept
# further down than that, at the cost of a longer walk; lower it to cut the
# walk short on a deep tree.
#
# 0 turns the limit off and walks as deep as the tree goes:
#
#   DIRSESH_GIT_MAX_DEPTH=0 dirsesh git
#
# The pruning still applies, so this is not the whole tree -- no hidden
# directory, no node_modules, and nothing below a repository already found --
# but it is the slowest the walk gets, and on a large root it is slow enough
# to notice on a chooser meant to open on a keypress.

note() {
  # Anything that is not the answer: tmux display-message inside tmux, stderr
  # outside it. Never stdout, which is reserved for the path dirsesh reads
  # back -- and a program run from a tmux popup loses its stderr when the
  # popup closes.
  if [ -n "$TMUX" ]; then tmux display-message "$1"; else echo "$1" >&2; fi
}

brief="" filter="" fetch=""
while [ $# -gt 0 ]; do
  case "$1" in
    -brief) brief=1 ;;
    -filter) filter=1 ;;
    -fetch) fetch=1 ;;
    -*)
      note "Error: Unknown option '$1' for 'dirsesh git'"
      exit 1
      ;;
    *)
      note "Error: 'dirsesh git' takes no arguments"
      exit 1
      ;;
  esac
  shift
done

# Fetching is only ever read back through -brief or -filter, so on its own it
# would open a connection per repository and then show the plain list, which
# reads none of what was fetched. Refused rather than quietly implying one of
# them: the flag that was left out is the one that says what to do with it.
if [ -n "$fetch" ] && [ -z "$brief" ] && [ -z "$filter" ]; then
  note "Error: '-fetch' only means something with '-brief' or '-filter'"
  exit 1
fi

# fzf is how this prints its answer, so it is checked up front rather than
# after the walk that finds the candidates.
if ! command -v fzf > /dev/null 2>&1; then
  note "Error: fzf is required but was not found on PATH"
  exit 1
fi

# Where the walk starts: $HOME, or DIRSESH_GIT_ROOT when it is set.
# Resolved with cd/pwd rather than taken as written, so a relative path or a
# trailing slash still yields paths `dirsesh at` can be handed -- and so a
# value naming nothing is an error here rather than an empty list further down.
# CDPATH is cleared because a match in it would both cd elsewhere and print the
# directory onto the stdout this is being read from.
root="${DIRSESH_GIT_ROOT:-$HOME}"
if ! root=$(CDPATH= cd -- "$root" 2> /dev/null && pwd); then
  if [ -n "$DIRSESH_GIT_ROOT" ]; then
    note "Error: DIRSESH_GIT_ROOT is not a directory: '$DIRSESH_GIT_ROOT'"
  else
    note "Error: \$HOME is not a directory: '$HOME'"
  fi
  exit 1
fi

# How far down from the root to walk, as find's -maxdepth. A repository is
# found by its .git, which sits one level below the repository itself, so the
# default of 5 reaches a repository four directories down -- $root/a/b/c/repo.
#
# 0 means no limit, and is the reason this is an array rather than a number:
# find has no -maxdepth value for "as deep as it goes", so the option is left
# off the command line entirely instead.
depth="${DIRSESH_GIT_MAX_DEPTH:-5}"
if ! [[ "$depth" =~ ^[0-9]{1,4}$ ]]; then
  note "Error: DIRSESH_GIT_MAX_DEPTH must be a whole number from 0 to 9999, 0 for no limit: '$DIRSESH_GIT_MAX_DEPTH'"
  exit 1
fi

maxdepth=(-maxdepth "$depth")
[ "$depth" -eq 0 ] && maxdepth=()

git_repo_row() {
  # One fzf row for the repo at $1 -- "<path>\t<what is displayed>" -- or
  # nothing with a non-zero status when -filter is on and it has nothing
  # waiting.
  #
  # The path is carried in a first column fzf is told not to display, so the
  # brief can be coloured without the selection having to be parsed back out.
  #
  # The flags arrive in the environment rather than as arguments, because xargs
  # calls this one repository at a time. Under -fetch the fetch happens here
  # rather than in a pass of its own, so one job both fetches and inspects a
  # repository and there is no barrier between the two.
  #
  # Args:
  #   $1: dir: the repository to inspect
  local dir="$1"
  local state branch="(detached)" ahead=0 behind=0 stats added=0 removed=0 untracked=0

  [ -n "$PICK_REPO_FETCH" ] && git -C "$dir" fetch --quiet 2>/dev/null

  # One `git status` for the branch, the ahead/behind counts and the untracked
  # files. Asking for each of those separately is the obvious way to write this
  # and costs four git processes instead of one; a picker opens on a keypress,
  # so the difference is the whole of the wait on a $HOME full of repositories.
  #
  # Failing is the guard that this is a repository at all -- it is also how a
  # repository deleted between the walk and here drops out.
  #
  # --porcelain=v2 is a format git keeps stable for scripts, unlike the text
  # `git status` prints for people. --no-optional-locks so a picker never
  # writes a refreshed index behind the back of whatever else is using the
  # repository. --untracked-files=normal because status.showUntrackedFiles=no
  # would otherwise silently report none, and this has to match what
  # `git status` shows a person rather than what they configured it to say.
  state=$(git --no-optional-locks -C "$dir" status \
    --porcelain=v2 --branch --untracked-files=normal 2>/dev/null) || return 1

  local line ab
  while IFS= read -r line; do
    case "$line" in
      # `(detached)` is what git itself prints here, and what is wanted.
      '# branch.head '*) branch="${line#\# branch.head }" ;;
      # `+<ahead> -<behind>`, and absent entirely when there is no upstream --
      # which is why both counts start at 0. Without -fetch they are counted
      # against the upstream ref as it stands on disk, which is as current as
      # the last fetch made it.
      '# branch.ab '*)
        ab="${line#\# branch.ab }"
        ahead="${ab%% *}"; ahead="${ahead#+}"
        behind="${ab##* }"; behind="${behind#-}"
        ;;
      # One line per untracked path, a new directory collapsed to one entry --
      # what `git status` itself shows.
      '? '*) untracked=$((untracked + 1)) ;;
    esac
  done <<< "$state"

  # Line counts are the one thing status does not carry. Against HEAD rather
  # than the index, so staged work counts as a change too; before the first
  # commit there is no HEAD to compare against, and the failure is what selects
  # the index against the empty tree instead.
  stats=$(git -C "$dir" diff HEAD --shortstat 2>/dev/null) \
    || stats=$(git -C "$dir" diff --cached --shortstat 2>/dev/null)

  # bash's own regex rather than a pipeline: `echo | grep | grep` twice is four
  # processes per repository to read two numbers already in hand.
  [[ "$stats" =~ ([0-9]+)\ insertion ]] && added="${BASH_REMATCH[1]}"
  [[ "$stats" =~ ([0-9]+)\ deletion ]] && removed="${BASH_REMATCH[1]}"

  # Nothing waiting, nothing unpushed, nothing uncommitted, nothing new. That
  # is what -filter drops; without it the repository still belongs on the list,
  # and -brief shows it as its branch alone.
  local waiting=1
  [ "$ahead" -gt 0 ] || [ "$behind" -gt 0 ] \
    || [ "$added" -gt 0 ] || [ "$removed" -gt 0 ] \
    || [ "$untracked" -gt 0 ] || waiting=0

  [ -n "$PICK_REPO_FILTER" ] && [ "$waiting" -eq 0 ] && return 1

  # -filter on its own narrows the list without decorating it, so the row is
  # the path twice and nothing more.
  if [ -z "$PICK_REPO_BRIEF" ]; then
    printf '%s\t%s\n' "$dir" "$dir"
    return 0
  fi

  local blue='\033[34m' yellow='\033[33m' green='\033[32m' red='\033[31m'
  local cyan='\033[36m' reset='\033[0m'
  local brief="${blue}${branch}${reset}"
  [ "$ahead" -gt 0 ] && brief+=" ${yellow}↑${ahead}${reset}"
  [ "$behind" -gt 0 ] && brief+=" ${yellow}↓${behind}${reset}"
  [ "$added" -gt 0 ] && brief+=" ${green}+${added}${reset}"
  [ "$removed" -gt 0 ] && brief+=" ${red}-${removed}${reset}"
  [ "$untracked" -gt 0 ] && brief+=" ${cyan}?${untracked}${reset}"

  printf '%s\t%s  %b\n' "$dir" "$dir" "$brief"
}

repo_paths() {
  # Every repository under the root, one path per line, printed as each one is
  # confirmed rather than all together at the end. Whoever reads this can start
  # showing repositories while the walk behind it is still running.
  #
  # -maxdepth bounds the walk under the root, unless it was turned off above;
  # -prune on .git and node_modules stops the descent right after printing a
  # hit, so nested repos (a dependency vendored with its own .git) are not
  # walked into; -prune on every other dot-directory keeps hidden directories --
  # caches like ~/.cache and ~/.npm, but also ~/.config, ~/.ssh, etc. -- out of
  # the walk entirely. node_modules matches are printed too, only to be pruned
  # from descent, so they are filtered back out below.
  #
  # `! -path "$root"` exempts the starting point from that last prune, because a
  # root that is itself hidden would otherwise be pruned before the walk began
  # and nothing would be found: a DIRSESH_GIT_ROOT of ~/.config, or of a
  # worktree under a hidden directory, is a reasonable thing to want.
  #
  # Matching .git by name rather than asking each directory whether it has one,
  # because .git is not always a directory: a linked worktree, and a checkout of
  # a bare clone, both carry a .git *file* holding a gitdir: line.
  #
  # The sort runs on the candidates, not the answers, and is the one place
  # output is held back before the checks below start -- no git has run yet,
  # so it is only the walk that is waited on, and the walk is milliseconds.
  #
  # A bare repository has no working tree to open a session in, and the
  # container of a `git clone --bare` layout carries a .git of its own -- a
  # file holding `gitdir: ./.bare`, or the bare repository sitting at .git
  # itself -- so the walk finds it looking like any other repo. Only git can
  # tell the two apart. The worktrees checked out beside it are found on their
  # own, and are what you actually want to sit in. This drops a stray
  # directory called .git that is no repository at all in the same breath:
  # rev-parse refuses it just the same.
  #
  # Checked 8 at a time rather than one at a time: each rev-parse costs about
  # two milliseconds, which is nothing until it is hundreds of repositories in
  # a row, and that wait is spent before the picker shows anything either way
  # -- fzf is not opened on the first path until this whole function returns.
  # Running the checks in parallel scrambles the order they finish in, but
  # nothing downstream depends on that order: the -brief/-filter callers sort
  # the decorated rows themselves once every repository is inspected, and fzf
  # does not care what order candidates arrive in.
  find "$root" "${maxdepth[@]}" \( -name .git -o -name node_modules \) -prune -print -o \( ! -path "$root" -a -name '.*' \) -prune 2>/dev/null \
    | grep '/\.git$' \
    | sed 's#/\.git$##' \
    | LC_ALL=C sort -u \
    | tr '\n' '\0' \
    | xargs -0 -P 8 -n 1 \
            bash -c '[ "$(git -C "$1" rev-parse --is-inside-work-tree 2>/dev/null)" = true ] && printf "%s\n" "$1" || true' _
}

# Nothing to show and nothing to leave out: the paths are the whole answer, and
# no repository has to be opened to produce them. Streamed straight into fzf,
# rather than collected first, so the list is on screen and usable while the
# walk behind it is still going -- the shape `dirsesh ls` has always had.
if [ -z "$brief" ] && [ -z "$filter" ]; then
  # Streaming gives up the one thing collecting the list gave for free: knowing
  # it was empty before fzf was handed it. fzf's own "no match" status cannot
  # stand in, because a query the person typed that matches nothing returns that
  # too. So the paths are teed past on their way to fzf and the file is what is
  # asked afterwards. --exit-0 is what keeps an empty list from opening a picker
  # on nothing first: with no match for the initial (empty) query, fzf exits
  # rather than starting.
  listed=$(mktemp) || {
    note "Error: could not create a temporary file"
    exit 1
  }
  trap 'rm -f "$listed"' EXIT

  selected=$(repo_paths | tee "$listed" | fzf --cycle --exit-0 --prompt "Repo > ")

  if [ ! -s "$listed" ]; then
    note "No git repositories found under $root"
    exit 1
  fi

  # Backing out is not a failure: say nothing and succeed.
  [ -n "$selected" ] || exit 0

  printf '%s\n' "$selected"
  exit 0
fi

# -brief and -filter both have to open every repository before anything can be
# shown -- one to decorate the rows, the other to know which rows there are --
# so this half collects the list rather than streaming it.
dirs=$(repo_paths)

if [ -z "$dirs" ]; then
  note "No git repositories found under $root"
  exit 1
fi

# Inspected 8 at a time: under -fetch each job opens a remote connection, and
# forking the whole list at once can hit the process limit. NUL separation so
# repository paths with spaces survive. `|| true` because a repository -filter
# drops is the ordinary case, not an xargs failure.
export -f git_repo_row
export PICK_REPO_BRIEF="$brief" PICK_REPO_FILTER="$filter" PICK_REPO_FETCH="$fetch"
rows=$(
  printf '%s\n' "$dirs" | tr '\n' '\0' \
    | xargs -0 -P 8 -n 1 \
            bash -c 'git_repo_row "$1" || true' _ \
    | LC_ALL=C sort
)

if [ -z "$rows" ]; then
  checked=$(printf '%s\n' "$dirs" | wc -l | tr -d ' ')
  note "Nothing to show: none of the $checked repositories checked have changes"
  exit 1
fi

# Only -filter leaves anything out, so only -filter has a count worth heading
# the list with: it says how many of the repositories checked made it, which is
# what distinguishes an empty-looking list from a short one.
fzf_header=()
if [ -n "$filter" ]; then
  checked=$(printf '%s\n' "$dirs" | wc -l | tr -d ' ')
  changed=$(printf '%s\n' "$rows" | wc -l | tr -d ' ')
  fzf_header=(--header "$(printf ':: \033[33m%s\033[0m of \033[33m%s\033[0m repositories have changes' \
    "$changed" "$checked")")
fi

selected=$(printf '%s\n' "$rows" \
  | fzf --ansi --cycle --delimiter=$'\t' --with-nth=2 --prompt "Repo > " "${fzf_header[@]}")

[ -n "$selected" ] || exit 0

printf '%s\n' "${selected%%	*}"
