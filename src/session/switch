#!/bin/bash
#
# switch: switch to another running tmux session, chosen with fzf.
#
# Usage: dirsesh switch [-b] [session]
#   -b       Hide the git branch each session's directory is on
#   session  Switch straight to this session instead of showing the picker.
#
# The session being switched from is not a destination, so it is left off the
# list and named in the header instead.

notify() {
  # Show a message: tmux display-message inside tmux, stderr otherwise.
  local msg="$1"
  if [ -n "$TMUX" ]; then
    tmux display-message "$msg"
  else
    echo "$msg" >&2
  fi
}

branch_of() {
  # The git branch a directory is on: "(detached)" for a detached HEAD, "-"
  # for a directory that is not a git repository at all.
  #
  # Args:
  #   $1: path
  local path="$1" branch
  branch=$(git -C "$path" branch --show-current 2>/dev/null)
  if [ -z "$branch" ]; then
    if git -C "$path" rev-parse --git-dir >/dev/null 2>&1; then
      branch="(detached)"
    else
      branch="-"
    fi
  fi
  echo "$branch"
}

show_branch=1
if [ "$1" = "-b" ]; then
  show_branch=""
  shift
fi

session="$1"

# No session given: pick one with fzf.
if [ -z "$session" ]; then
  # Formatted rather than cut out of `tmux ls`, which would split a name at
  # its first colon. The path rides along whether or not -b was given, since
  # it is what a branch lookup needs and dropping it for the plain case would
  # only complicate the code below for no real saving.
  session_data=$(tmux list-sessions -F '#{session_name}	#{session_path}' 2>/dev/null)

  if [ -z "$session_data" ]; then
    notify "No active sessions"
    exit 1
  fi

  # The session being switched from is not a destination: it is dropped from
  # the list and named in the header instead. Nothing is dropped outside
  # tmux, where there is no session to switch from.
  current="" current_path=""
  if [ -n "$TMUX" ]; then
    current=$(tmux display-message -p '#{session_name}' 2>/dev/null)
    current_path=$(tmux display-message -p '#{session_path}' 2>/dev/null)
  fi

  fzf_args=(--cycle --prompt "Session > ")
  if [ -n "$current" ]; then
    session_data=$(printf '%s\n' "$session_data" | awk -F'\t' -v cur="$current" '$1 != cur')

    if [ -z "$session_data" ]; then
      notify "No other active sessions"
      exit 1
    fi
  fi

  if [ -n "$show_branch" ]; then
    # The session name rides along in a first column fzf is told not to
    # display, so it can be recovered after the row is styled and padded for
    # the branch column beside it. The current session is folded into the
    # width too, so its header row lines up with the columns below it even
    # when its name is the longest one around.
    name_label='session' branch_label='branch'
    max_name=${#name_label}
    [ -n "$current" ] && (( ${#current} > max_name )) && max_name=${#current}
    while IFS=$'\t' read -r name _; do
      (( ${#name} > max_name )) && max_name=${#name}
    done <<< "$session_data"

    fzf_input=$(printf '%s\n' "$session_data" | while IFS=$'\t' read -r name path; do
      printf '%s\t%-*s  \033[33m%s\033[0m\n' "$name" "$max_name" "$name" "$(branch_of "$path")"
    done)

    header="$(printf '\033[2m%-*s\033[0m  \033[2;33m%s\033[0m' "$max_name" "$name_label" "$branch_label")"
    if [ -n "$current" ]; then
      header="$(printf '%-*s  \033[33m%s\033[0m' "$max_name" "$current" "$(branch_of "$current_path")")"$'\n'"$header"
    fi
    fzf_args+=(--header "$header")

    session=$(echo "$fzf_input" \
      | fzf --ansi --with-nth=2 --delimiter=$'\t' "${fzf_args[@]}" \
      | cut -f1)
  else
    if [ -n "$current" ]; then
      fzf_args+=(--header "$(printf '\033[33m%s\033[0m' "$current")")
    fi
    sessions=$(printf '%s\n' "$session_data" | cut -f1)
    session=$(echo "$sessions" | fzf "${fzf_args[@]}")
  fi

  [ -n "$session" ] || exit 0
fi

if ! tmux has-session -t "=$session" 2>/dev/null; then
  notify "Error: Session '$session' is not running"
  exit 1
fi

# Switch to the session if inside tmux, attach otherwise.
if [ -n "$TMUX" ]; then
  tmux switch-client -t "=$session"
else
  tmux attach-session -t "=$session"
fi
