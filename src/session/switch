#!/bin/bash
#
# switch: switch to another running tmux session, chosen with fzf.
#
# Usage: dirsesh switch [-b] [-p] [session]
#   -b       Hide the git branch each session's directory is on
#   -p       Show the picker in a tmux popup, sized to fit the sessions listed
#   session  Switch straight to this session instead of showing the picker.
#
# The session being switched from is not a destination, so it is left off the
# list and named in the header instead.

notify() {
  # Show a message: tmux display-message inside tmux, stderr otherwise.
  local msg="$1"
  if [ -n "$TMUX" ]; then
    tmux display-message "$msg"
  else
    echo "$msg" >&2
  fi
}

branch_of() {
  # The git branch a directory is on: "(detached)" for a detached HEAD, "-"
  # for a directory that is not a git repository at all.
  #
  # Args:
  #   $1: path
  local path="$1" branch
  branch=$(git -C "$path" branch --show-current 2>/dev/null)
  if [ -z "$branch" ]; then
    if git -C "$path" rev-parse --git-dir >/dev/null 2>&1; then
      branch="(detached)"
    else
      branch="-"
    fi
  fi
  echo "$branch"
}

show_branch=1
popup=""
while [ $# -gt 0 ]; do
  case "$1" in
    -b) show_branch=""; shift ;;
    -p) popup=1; shift ;;
    *) break ;;
  esac
done

session="$1"

# No session given: pick one with fzf.
if [ -z "$session" ]; then
  # Formatted rather than cut out of `tmux ls`, which would split a name at
  # its first colon. The path rides along whether or not -b was given, since
  # it is what a branch lookup needs and dropping it for the plain case would
  # only complicate the code below for no real saving.
  session_data=$(tmux list-sessions -F '#{session_name}	#{session_path}' 2>/dev/null)

  if [ -z "$session_data" ]; then
    notify "No active sessions"
    exit 1
  fi

  # The session being switched from is not a destination: it is dropped from
  # the list and named in the header instead. Nothing is dropped outside
  # tmux, where there is no session to switch from.
  current="" current_path=""
  if [ -n "$TMUX" ]; then
    current=$(tmux display-message -p '#{session_name}' 2>/dev/null)
    current_path=$(tmux display-message -p '#{session_path}' 2>/dev/null)
  fi

  prompt_text='> '
  fzf_args=(--cycle --prompt "$prompt_text")
  if [ -n "$current" ]; then
    session_data=$(printf '%s\n' "$session_data" | awk -F'\t' -v cur="$current" '$1 != cur')

    # Being the only session left is not a failure -- there is simply nowhere
    # to switch to -- so this says so and exits clean.
    if [ -z "$session_data" ]; then
      notify "No other active sessions"
      exit 0
    fi
  fi

  # -p: rather than build the picker here, size a popup to fit what it is
  # about to list and hand the actual picking to a plain `switch` run inside
  # it. -p is not forwarded, so that inner run falls straight through to the
  # fzf below instead of opening a popup of its own.
  if [ -n "$popup" ]; then
    if [ -z "$TMUX" ]; then
      notify "Error: -p requires running inside tmux"
      exit 1
    fi

    # The "session"/"branch" labels only count toward the width when
    # branches are shown, since that is the one case where they are drawn
    # as a header -- the plain list (-b) has no column of its own to line
    # up, so nothing there is ever as wide as the labels.
    max_name=0
    max_branch=0
    if [ -n "$show_branch" ]; then
      name_label='session' branch_label='branch'
      max_name=${#name_label}
      max_branch=${#branch_label}
    fi
    [ -n "$current" ] && (( ${#current} > max_name )) && max_name=${#current}

    session_count=0
    while IFS=$'\t' read -r name path; do
      (( ${#name} > max_name )) && max_name=${#name}
      if [ -n "$show_branch" ]; then
        branch=$(branch_of "$path")
        (( ${#branch} > max_branch )) && max_branch=${#branch}
      fi
      session_count=$((session_count + 1))
    done <<< "$session_data"

    if [ -n "$current" ] && [ -n "$show_branch" ]; then
      branch=$(branch_of "$current_path")
      (( ${#branch} > max_branch )) && max_branch=${#branch}
    fi

    # Width: the longest row fzf will draw -- name plus, with branches
    # shown, the gap and the longest branch -- or the prompt itself if that
    # is somehow longer. +6 on top of that: 2 columns for the popup's
    # border, 3 for fzf's own chrome (a gutter down the left of every row
    # plus a column of slack on the right, measured against fzf 0.74's
    # default theme), and 1 more to spare in case a wider pointer or a
    # scrollbar asks for it.
    content_width=$max_name
    [ -n "$show_branch" ] && content_width=$((max_name + 2 + max_branch))
    prompt_width=${#prompt_text}
    (( prompt_width > content_width )) && content_width=$prompt_width

    header_lines=0
    [ -n "$show_branch" ] && header_lines=1
    [ -n "$current" ] && header_lines=$((header_lines + 1))

    # Height: one row per session, the header row(s) above them, fzf's
    # search line, and -- separately -- the match-count line fzf draws
    # above it by default. Falling short by even one row drops a session
    # off the bottom of the list and puts fzf into scroll mode, which is
    # also what eats into the width above. +2 for the popup's border, +1
    # more for a blank row of breathing room at the bottom -- dropped again
    # by the client clamp below whenever there is no room to spare for it.
    popup_width=$((content_width + 6))
    popup_height=$((session_count + header_lines + 2 + 2 + 1))

    (( popup_width < 20 )) && popup_width=20
    (( popup_height < 6 )) && popup_height=6

    # The client clamp runs last, after the floor above: a small client is
    # the one ceiling nothing -- not even the minimum -- gets to exceed.
    client_width=$(tmux display-message -p '#{client_width}')
    client_height=$(tmux display-message -p '#{client_height}')
    (( popup_width > client_width )) && popup_width=$client_width
    (( popup_height > client_height )) && popup_height=$client_height

    popup_cmd="dirsesh switch"
    [ -z "$show_branch" ] && popup_cmd="$popup_cmd -b"

    tmux popup -w "$popup_width" -h "$popup_height" -E "$popup_cmd"
    exit $?
  fi

  if [ -n "$show_branch" ]; then
    # The session name rides along in a first column fzf is told not to
    # display, so it can be recovered after the row is styled and padded for
    # the branch column beside it. The current session is folded into the
    # width too, so its header row lines up with the columns below it even
    # when its name is the longest one around.
    name_label='session' branch_label='branch'
    max_name=${#name_label}
    [ -n "$current" ] && (( ${#current} > max_name )) && max_name=${#current}
    while IFS=$'\t' read -r name _; do
      (( ${#name} > max_name )) && max_name=${#name}
    done <<< "$session_data"

    fzf_input=$(printf '%s\n' "$session_data" | while IFS=$'\t' read -r name path; do
      printf '%s\t%-*s  \033[33m%s\033[0m\n' "$name" "$max_name" "$name" "$(branch_of "$path")"
    done)

    header="$(printf '\033[2m%-*s\033[0m  \033[2;33m%s\033[0m' "$max_name" "$name_label" "$branch_label")"
    if [ -n "$current" ]; then
      # Dim rather than the list's own colors: the current session is not
      # a choice on this list, just context for it.
      header="$(printf '\033[2m%-*s\033[0m  \033[2;33m%s\033[0m' "$max_name" "$current" "$(branch_of "$current_path")")"$'\n'"$header"
    fi
    fzf_args+=(--header "$header")

    session=$(echo "$fzf_input" \
      | fzf --ansi --with-nth=2 --delimiter=$'\t' "${fzf_args[@]}" \
      | cut -f1)
  else
    if [ -n "$current" ]; then
      fzf_args+=(--header "$(printf '\033[2m%s\033[0m' "$current")")
    fi
    sessions=$(printf '%s\n' "$session_data" | cut -f1)
    session=$(echo "$sessions" | fzf "${fzf_args[@]}")
  fi

  [ -n "$session" ] || exit 0
fi

if ! tmux has-session -t "=$session" 2>/dev/null; then
  notify "Error: Session '$session' is not running"
  exit 1
fi

# Switch to the session if inside tmux, attach otherwise.
if [ -n "$TMUX" ]; then
  tmux switch-client -t "=$session"
else
  tmux attach-session -t "=$session"
fi
